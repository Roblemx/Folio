<UserControl x:Class="Folio.Views.CoinDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folio.ViewModels"
             xmlns:controls="clr-namespace:Folio.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CoinDetailViewModel}">
    <Grid Margin="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="{Binding MarketPriceText}" Style="{StaticResource Hero}" FontSize="26"
                           HorizontalAlignment="Right" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                    <TextBlock Text="24h" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ChangeText}" FontSize="13"
                               Foreground="{Binding IsUp, Converter={StaticResource UpBrush}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="←" Style="{StaticResource GhostButton}" Width="40" Height="36" Padding="0"
                        Command="{Binding BackCommand}" />
                <controls:CoinIcon Diameter="40" Margin="14,0,0,0" CoinId="{Binding CoinId}"
                                   ImageUrl="{Binding ImageUrl}" Initial="{Binding Initial}" Accent="{Binding Accent}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Symbol}" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Price chart -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Content="24H" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="24H"
                                          IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=24H, Mode=OneWay}" />
                            <ToggleButton Content="1W" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="1W"
                                          IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=1W, Mode=OneWay}" />
                            <ToggleButton Content="1M" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="1M"
                                          IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=1M, Mode=OneWay}" />
                            <ToggleButton Content="1Y" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="1Y"
                                          IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=1Y, Mode=OneWay}" />
                            <ToggleButton Content="ALL" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="ALL"
                                          IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=ALL, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Price" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RangeChangeText}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding RangeIsUp, Converter={StaticResource UpBrush}}" />
                        </StackPanel>
                    </DockPanel>
                    <controls:AreaChart Height="300" Margin="0,12,0,0"
                                        Values="{Binding ChartValues}" Stroke="{Binding Accent}" TooltipFormat="N2" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Market cap" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding MarketCapText}" FontSize="13" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Position + editor -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Your position" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Hero}" FontSize="28" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding HasPnl, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="P&amp;L" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding PnlText}" FontSize="14"
                                   Foreground="{Binding PnlUp, Converter={StaticResource UpBrush}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Avg cost" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding AvgCostText}" FontSize="13" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,18,0,18" />

                    <!-- Manual editor (manual mode only) -->
                    <StackPanel Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Amount" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource TextInput}" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Average buy price (optional)" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                        <TextBox Style="{StaticResource TextInput}" Text="{Binding AvgPriceText, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                                HorizontalAlignment="Stretch" Command="{Binding SaveCommand}" />
                        <Button Content="Remove from portfolio" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                                HorizontalAlignment="Stretch" Command="{Binding RemoveCommand}"
                                Visibility="{Binding Holds, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Derived note (transaction mode) -->
                    <TextBlock Text="This position is derived from your transactions. Edit it in the Transactions tab."
                               Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding CanEdit, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
