<UserControl x:Class="Folio.Views.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folio.ViewModels"
             xmlns:controls="clr-namespace:Folio.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WatchViewModel}">
    <Grid>
        <Grid Margin="36,28,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="+  Add address" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddAddressCommand}" />
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}"
                        Margin="0,0,10,0" Command="{Binding RefreshCommand}" />
                <StackPanel>
                    <TextBlock Text="Watch-only" Style="{StaticResource Hero}" />
                    <TextBlock Text="Track any public address read-only — balances from public explorers. No keys, no signing."
                               Style="{StaticResource Caption}" Margin="2,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Total -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,22,0,0"
                    Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="Watch-only total" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Hero}" FontSize="26"
                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🔒 Read-only" FontSize="13.5" FontWeight="Medium" />
                        <TextBlock Text="These balances are informational and never mixed with your private keys."
                                   Style="{StaticResource Caption}" FontSize="11.5" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Column header -->
            <Grid Grid.Row="2" Margin="14,22,8,0"
                  Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Address" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="1" Text="Balance" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="Value" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Rows -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                          Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="rb" Background="Transparent" CornerRadius="10" Padding="14,12" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:CoinIcon Diameter="34" CoinId="{Binding CoinId}"
                                                           ImageUrl="{Binding ImageUrl}" Initial="{Binding ChainSymbol}"
                                                           Accent="{Binding ChainColor}" />
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="{Binding ShortAddress}" Style="{StaticResource Caption}"
                                                       FontSize="11.5" FontFamily="Consolas" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding AmountText}" FontSize="13.5" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="10.5"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FontSize="14" FontWeight="Medium" />

                                    <Button Grid.Column="3" Width="30" Height="30" Cursor="Hand" ToolTip="Remove"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteRowCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="db" Background="Transparent" CornerRadius="7">
                                                    <TextBlock x:Name="dx" Text="✕" FontSize="13" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="db" Property="Background" Value="{DynamicResource NegativeBrush}" />
                                                        <Setter TargetName="dx" Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" SourceName="rb" Value="True">
                                    <Setter TargetName="rb" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasAddresses, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="No watched addresses" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                <TextBlock Text="Add a Bitcoin or Ethereum address to follow its balance — read-only, no keys needed."
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="440"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <Button Content="+  Add an address" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding AddAddressCommand}" />
            </StackPanel>
        </Grid>

        <!-- Editor overlay -->
        <Grid Background="#99000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="26">
                <StackPanel>
                    <TextBlock Text="Add watch-only address" Style="{StaticResource Heading}" />

                    <TextBlock Text="Chain" Style="{StaticResource Caption}" Margin="0,16,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="Bitcoin" Style="{StaticResource ChipToggle}"
                                      Command="{Binding SetChainCommand}" CommandParameter="Bitcoin"
                                      IsChecked="{Binding ChainName, Converter={StaticResource EqualsBool}, ConverterParameter=Bitcoin, Mode=OneWay}" />
                        <ToggleButton Content="Ethereum" Style="{StaticResource ChipToggle}"
                                      Command="{Binding SetChainCommand}" CommandParameter="Ethereum"
                                      IsChecked="{Binding ChainName, Converter={StaticResource EqualsBool}, ConverterParameter=Ethereum, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="Public address" Style="{StaticResource Caption}" Margin="0,8,0,6" />
                    <TextBox Style="{StaticResource TextInput}" FontFamily="Consolas"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Label (optional)" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource TextInput}"
                             Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="🔒 Folio only reads the public balance from a block explorer. Never paste a private key or seed phrase — those are never needed and never asked for." />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Command="{Binding CancelEditorCommand}" />
                        <Button Content="Add address" Style="{StaticResource PrimaryButton}" Width="120"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
