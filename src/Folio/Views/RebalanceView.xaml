<UserControl x:Class="Folio.Views.RebalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folio.ViewModels"
             xmlns:controls="clr-namespace:Folio.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:RebalanceViewModel}">
    <Grid Margin="36,28,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Targets total " Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TargetsSumText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding IsBalanced, Converter={StaticResource UpBrush}}" />
                    </StackPanel>
                </Border>
                <Button Content="Normalize to 100%" Style="{StaticResource GhostButton}" Height="36" Margin="10,0,0,0"
                        Command="{Binding NormalizeCommand}" />
                <Button Content="Clear" Style="{StaticResource GhostButton}" Height="36" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Rebalance" Style="{StaticResource Hero}" />
                <TextBlock Text="Set a target weight for each coin — Folio shows the drift and what to buy or sell."
                           Style="{StaticResource Caption}" Margin="2,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Column header -->
        <Grid Grid.Row="1" Margin="14,24,8,0"
              Visibility="{Binding HasHoldings, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Asset" Style="{StaticResource Caption}" />
            <TextBlock Grid.Column="1" Text="Current" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="Target %" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,12,0" />
            <TextBlock Grid.Column="3" Text="Drift" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Action" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
        </Grid>

        <!-- Rows -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                      Visibility="{Binding HasHoldings, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="rb" Background="Transparent" CornerRadius="10" Padding="14,12" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="250" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:CoinIcon Diameter="32" CoinId="{Binding CoinId}"
                                                       ImageUrl="{Binding ImageUrl}" Initial="{Binding Initial}"
                                                       Accent="{Binding Accent}" />
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13.5" />
                                        <TextBlock Text="{Binding Symbol}" Style="{StaticResource Caption}" FontSize="11.5" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding CurrentText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />

                                <!-- Target editable -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBox Style="{StaticResource TextInput}" Width="68" Height="32"
                                             HorizontalContentAlignment="Right"
                                             Text="{Binding TargetText, UpdateSourceTrigger=LostFocus}" />
                                    <TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding DriftText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" FontSize="13.5"
                                           Foreground="{Binding Underweight, Converter={StaticResource UpBrush}}" />

                                <TextBlock Grid.Column="4" Text="{Binding ActionText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" FontSize="13" FontWeight="Medium" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" SourceName="rb" Value="True">
                                <Setter TargetName="rb" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOnTarget}" Value="True">
                                <Setter TargetName="rb" Property="Opacity" Value="0.72" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasHoldings, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="Nothing to rebalance yet" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
            <TextBlock Text="Add holdings first, then set target weights here to see buy/sell hints."
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
