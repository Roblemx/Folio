<UserControl x:Class="Folio.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folio.ViewModels"
             xmlns:controls="clr-namespace:Folio.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AlertsViewModel}">
    <Grid>
        <Grid Margin="36,28,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="+  New alert" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddAlertCommand}" />
                <StackPanel>
                    <TextBlock Text="Alerts" Style="{StaticResource Hero}" />
                    <TextBlock Text="Get notified when a coin crosses your target price. Checked on every refresh."
                               Style="{StaticResource Caption}" Margin="2,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Column header -->
            <Grid Grid.Row="1" Margin="14,24,8,0"
                  Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Coin" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="1" Text="Condition" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="2" Text="Target" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="Current" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource Caption}" Margin="16,0,0,0" />
                <TextBlock Grid.Column="5" Text="On" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Rows -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                          Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="rb" Background="Transparent" CornerRadius="10" Padding="14,11" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Coin -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:CoinIcon Diameter="32" CoinId="{Binding CoinId}"
                                                           ImageUrl="{Binding ImageUrl}" Initial="{Binding Initial}"
                                                           Accent="{Binding Accent}" />
                                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13.5" />
                                            <TextBlock Text="{Binding Symbol}" Style="{StaticResource Caption}" FontSize="11.5" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Condition -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="▲" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource PositiveBrush}"
                                                   Visibility="{Binding IsAbove, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="▼" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource NegativeBrush}"
                                                   Visibility="{Binding IsAbove, Converter={StaticResource InverseBoolToVis}}" />
                                        <TextBlock Text="{Binding ConditionText}" FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TargetText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FontSize="13.5" FontWeight="Medium" />
                                    <TextBlock Grid.Column="3" Text="{Binding CurrentText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FontSize="13.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />

                                    <!-- Status -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,7,0" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                Visibility="{Binding HasTriggered, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Actions: enable toggle + delete -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleEnabledCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                        <Button Width="30" Height="30" Cursor="Hand" ToolTip="Delete" Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteRowCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="db" Background="Transparent" CornerRadius="7">
                                                        <TextBlock x:Name="dx" Text="✕" FontSize="13" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="db" Property="Background" Value="{DynamicResource NegativeBrush}" />
                                                            <Setter TargetName="dx" Property="Foreground" Value="White" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" SourceName="rb" Value="True">
                                    <Setter TargetName="rb" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="rb" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="No alerts yet" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                <TextBlock Text="Create a price alert and Folio will notify you when it triggers."
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <Button Content="+  New alert" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding AddAlertCommand}" />
            </StackPanel>
        </Grid>

        <!-- Editor overlay -->
        <Grid Background="#99000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="26">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource Heading}" />

                    <!-- Coin search -->
                    <TextBlock Text="Coin" Style="{StaticResource Caption}" Margin="0,16,0,6" />
                    <TextBox Style="{StaticResource TextInput}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search a coin…" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Margin="0,8,0,0"
                            MaxHeight="170"
                            Visibility="{Binding SearchResults.Count, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickCoinCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Left">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="Transparent" Padding="12,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                            <TextBlock Text="{Binding Symbol}" Style="{StaticResource Caption}"
                                                                       FontSize="11.5" Margin="8,1,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{Binding SelectedCoinLabel}" FontWeight="Medium" Margin="0,10,0,0"
                               Visibility="{Binding SelectedCoinLabel, Converter={StaticResource BoolToVis}}" />

                    <!-- Direction -->
                    <TextBlock Text="Trigger when price" Style="{StaticResource Caption}" Margin="0,14,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="Rises above" Style="{StaticResource ChipToggle}"
                                      Command="{Binding SetDirectionCommand}" CommandParameter="Above"
                                      IsChecked="{Binding DirectionName, Converter={StaticResource EqualsBool}, ConverterParameter=Above, Mode=OneWay}" />
                        <ToggleButton Content="Falls below" Style="{StaticResource ChipToggle}"
                                      Command="{Binding SetDirectionCommand}" CommandParameter="Below"
                                      IsChecked="{Binding DirectionName, Converter={StaticResource EqualsBool}, ConverterParameter=Below, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Target price -->
                    <TextBlock Text="Target price" Style="{StaticResource Caption}" Margin="0,8,0,6" />
                    <TextBox Style="{StaticResource TextInput}"
                             Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Note -->
                    <TextBlock Text="Note (optional)" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource TextInput}"
                             Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Command="{Binding CancelEditorCommand}" />
                        <Button Content="Save alert" Style="{StaticResource PrimaryButton}" Width="120"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
