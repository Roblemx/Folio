<UserControl x:Class="Folio.Views.DcaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folio.ViewModels"
             xmlns:controls="clr-namespace:Folio.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DcaViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36,28,36,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="DCA backtester" Style="{StaticResource Hero}" />
                <TextBlock Text="See what investing a fixed amount on a schedule would be worth today — using real price history."
                           Style="{StaticResource Caption}" Margin="2,4,0,0" />
            </StackPanel>

            <!-- Inputs -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Coin search -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Coin" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <Grid>
                            <TextBox x:Name="DcaSearch" Style="{StaticResource TextInput}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search a coin…" />
                            <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}"
                                   PlacementTarget="{Binding ElementName=DcaSearch}" Placement="Bottom"
                                   StaysOpen="True" AllowsTransparency="True"
                                   Width="{Binding ActualWidth, ElementName=DcaSearch}">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" MaxHeight="240" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.4" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.PickCoinCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Left">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="Transparent" Padding="12,8" CornerRadius="6">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                                        <TextBlock Text="{Binding Symbol}" Style="{StaticResource Caption}"
                                                                                   FontSize="11.5" Margin="8,1,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <TextBlock Text="{Binding SelectedCoinLabel}" FontWeight="Medium" Margin="0,8,0,0"
                                   Visibility="{Binding SelectedCoinLabel, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Amount -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Width="160">
                        <TextBlock Text="Amount per buy" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource TextInput}"
                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Frequency -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                        <TextBlock Text="Frequency" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="Daily" Style="{StaticResource ChipToggle}"
                                          Command="{Binding SetFrequencyCommand}" CommandParameter="Daily"
                                          IsChecked="{Binding FrequencyName, Converter={StaticResource EqualsBool}, ConverterParameter=Daily, Mode=OneWay}" />
                            <ToggleButton Content="Weekly" Style="{StaticResource ChipToggle}"
                                          Command="{Binding SetFrequencyCommand}" CommandParameter="Weekly"
                                          IsChecked="{Binding FrequencyName, Converter={StaticResource EqualsBool}, ConverterParameter=Weekly, Mode=OneWay}" />
                            <ToggleButton Content="Monthly" Style="{StaticResource ChipToggle}"
                                          Command="{Binding SetFrequencyCommand}" CommandParameter="Monthly"
                                          IsChecked="{Binding FrequencyName, Converter={StaticResource EqualsBool}, ConverterParameter=Monthly, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Range -->
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                        <TextBlock Text="Period" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="1M" Style="{StaticResource ChipToggle}"
                                          Command="{Binding SetRangeCommand}" CommandParameter="1M"
                                          IsChecked="{Binding RangeName, Converter={StaticResource EqualsBool}, ConverterParameter=1M, Mode=OneWay}" />
                            <ToggleButton Content="1Y" Style="{StaticResource ChipToggle}"
                                          Command="{Binding SetRangeCommand}" CommandParameter="1Y"
                                          IsChecked="{Binding RangeName, Converter={StaticResource EqualsBool}, ConverterParameter=1Y, Mode=OneWay}" />
                            <ToggleButton Content="All" Style="{StaticResource ChipToggle}"
                                          Command="{Binding SetRangeCommand}" CommandParameter="ALL"
                                          IsChecked="{Binding RangeName, Converter={StaticResource EqualsBool}, ConverterParameter=ALL, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results -->
            <Grid Grid.Row="2" Margin="0,16,0,0"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Stat tiles -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Invested" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding InvestedText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding ContributionsText, StringFormat='{}{0} buys'}"
                                           Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Value today" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding CurrentValueText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding CoinsText}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Net return" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding RoiText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"
                                           Foreground="{Binding RoiUp, Converter={StaticResource UpBrush}}" />
                                <TextBlock Text="vs invested" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Avg buy price" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding AvgPriceText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="dollar-cost averaged" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Verdict vs lump sum -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Lump sum value" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding LumpValueText}" FontSize="16" FontWeight="Medium" />
                                    <TextBlock Text="{Binding LumpRoiText}" FontSize="13" Margin="8,2,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏁" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding VerdictText}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Compared with investing the same total at the start of the period."
                                           Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Value over time -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Portfolio value over time" Style="{StaticResource Caption}" />
                            <controls:AreaChart Height="240" Margin="0,12,0,0"
                                                Values="{Binding ChartValues}"
                                                Stroke="{Binding RoiUp, Converter={StaticResource UpBrush}}"
                                                TooltipFormat="N0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Prompt -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="40"
                    Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Pick a coin to run a backtest" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose an asset, an amount and a schedule above to see how dollar-cost averaging would have played out."
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="460"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
