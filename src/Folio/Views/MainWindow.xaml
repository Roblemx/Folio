<Window x:Class="Folio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Folio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ShellViewModel}"
        Title="Folio" Height="820" Width="1280"
        Icon="/Assets/icon.ico"
        MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        WindowStyle="None" AllowsTransparency="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                BorderBrush="#11151F" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="16" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Folio" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Local portfolio tracker" Margin="10,1,0,0" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="OnMinimize" Style="{StaticResource CaptionButton}" Height="38" ToolTip="Minimize">
                        <Path Data="M0,0 H10" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Click="OnMaximize" Style="{StaticResource CaptionButton}" Height="38" ToolTip="Maximize">
                        <Grid Width="10" Height="10">
                            <Rectangle x:Name="MaxGlyph" Width="10" Height="10" StrokeThickness="1.2"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Grid x:Name="RestoreGlyph" Visibility="Collapsed">
                                <Rectangle Width="8" Height="8" StrokeThickness="1.2"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Path Data="M2,0 H10 V8" StrokeThickness="1.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Click="OnClose" Style="{StaticResource CaptionCloseButton}" Height="38" ToolTip="Close">
                        <Path Data="M0,0 L10,10 M0,10 L10,0" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource BgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,18,0,12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,0,0,16">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Folio" Margin="11,0,0,0" VerticalAlignment="Center"
                                   FontSize="19" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Portfolio switcher -->
                    <StackPanel DockPanel.Dock="Top" Margin="14,0,14,16">
                        <ToggleButton x:Name="SwitcherBtn" IsChecked="{Binding IsSwitcherOpen, Mode=TwoWay}" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="sb" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="12,8">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                                                  VerticalAlignment="Center" Margin="8,2,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="PORTFOLIO" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFaintBrush}" />
                                                <TextBlock Text="{Binding ActivePortfolioName}" FontSize="13.5"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="sb" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsSwitcherOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SwitcherBtn}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               VerticalOffset="6">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="11" Width="262" Padding="6" Margin="6">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.45" />
                                </Border.Effect>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding PortfolioItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectPortfolioCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="pb" Background="Transparent" CornerRadius="8" Padding="10,8">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="12"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                                               Margin="8,0,0,0" />
                                                                    <Border DockPanel.Dock="Left" Width="6" Height="6" CornerRadius="3"
                                                                            Background="{DynamicResource AccentBrush}" Margin="0,0,9,0"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="pb" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="6,6" />

                                    <!-- Create / rename editor -->
                                    <StackPanel Margin="4,0" Visibility="{Binding IsEditingPortfolio, Converter={StaticResource BoolToVis}}">
                                        <TextBox Style="{StaticResource TextInput}" Height="34"
                                                 Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,2">
                                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Height="32"
                                                    Command="{Binding CancelEditorCommand}" Margin="0,0,8,0" />
                                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Height="32"
                                                    Command="{Binding ConfirmEditorCommand}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Visibility="{Binding IsEditingPortfolio, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Style="{StaticResource MenuItemButton}" Command="{Binding BeginCreateCommand}"
                                                Content="+  New portfolio" />
                                        <Button Style="{StaticResource MenuItemButton}" Command="{Binding BeginRenameCommand}"
                                                Content="Rename current"
                                                Visibility="{Binding CanModifyActive, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource MenuItemButton}" Command="{Binding DeleteActiveCommand}"
                                                Content="Delete current" Foreground="{DynamicResource NegativeBrush}"
                                                Visibility="{Binding CanDeleteActive, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Height="42">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left"
                                                           Fill="{DynamicResource AccentBrush}" Visibility="Hidden" />
                                                <TextBlock x:Name="tx" Text="{Binding Title}" Margin="22,0,0,0"
                                                           VerticalAlignment="Center" FontSize="14"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tx" Property="Foreground"
                                                            Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="tx" Property="Foreground"
                                                            Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter TargetName="tx" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Privacy reassurance footer -->
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Margin="20,0,16,2">
                        <TextBlock Text="🔒 Local &amp; private" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="No account. No cloud. No keys." FontSize="10.5"
                                   Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Grid />
                </DockPanel>
            </Border>

            <!-- Content host -->
            <Border Grid.Column="1" Background="{DynamicResource BgBrush}">
                <ContentControl Content="{Binding Navigation.CurrentPage}" />
            </Border>
        </Grid>

        <!-- Toast host (top-right, over everything) -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}" VerticalAlignment="Top"
                      HorizontalAlignment="Right" Margin="0,16,18,0" Width="340">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="11" Margin="0,0,0,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.5" />
                        </Border.Effect>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" CornerRadius="2,0,0,2"
                                    Background="{Binding IsUp, Converter={StaticResource UpBrush}}" />
                            <Button DockPanel.Dock="Right" Width="34" VerticalAlignment="Top" Cursor="Hand"
                                    Command="{Binding DataContext.DismissToastCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Height="34">
                                            <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFaintBrush}" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel Margin="14,12,4,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔔" FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
