<UserControl x:Class="Folio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folio.ViewModels"
             xmlns:controls="clr-namespace:Folio.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasHoldings, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="36,28,36,40">

                <!-- Header -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dashboard" Style="{StaticResource Hero}" />
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,3"
                                VerticalAlignment="Center" Margin="14,6,0,0"
                                Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="offline · last known" Style="{StaticResource Caption}" FontSize="11" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Hero card -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total value" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TotalValueText}" Style="{StaticResource Hero}" FontSize="40" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding BtcValueText}" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding HasBtcValue, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="24h" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Change24hText}" FontSize="14"
                                           Foreground="{Binding Change24hUp, Converter={StaticResource UpBrush}}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Visibility="{Binding HasPnl, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="All-time P&amp;L" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding PnlText}" FontSize="18" FontWeight="Medium" HorizontalAlignment="Right"
                                       Margin="0,4,0,0" Foreground="{Binding PnlUp, Converter={StaticResource UpBrush}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"
                                        Visibility="{Binding HasRealized, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Realized" Style="{StaticResource Caption}" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding RealizedText}" FontSize="12.5"
                                           Foreground="{Binding RealizedUp, Converter={StaticResource UpBrush}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Value over time -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton Content="24H" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="24H"
                                              IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=24H, Mode=OneWay}" />
                                <ToggleButton Content="1W" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="1W"
                                              IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=1W, Mode=OneWay}" />
                                <ToggleButton Content="1M" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="1M"
                                              IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=1M, Mode=OneWay}" />
                                <ToggleButton Content="1Y" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="1Y"
                                              IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=1Y, Mode=OneWay}" />
                                <ToggleButton Content="ALL" Style="{StaticResource RangeTab}" Command="{Binding SelectRangeCommand}" CommandParameter="ALL"
                                              IsChecked="{Binding SelectedRange, Converter={StaticResource EqualsBool}, ConverterParameter=ALL, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Value over time" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding RangeChangeText}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding RangeIsUp, Converter={StaticResource UpBrush}}" />
                            </StackPanel>
                        </DockPanel>
                        <controls:AreaChart Height="240" Margin="0,12,0,0"
                                            Values="{Binding ChartValues}" Stroke="{DynamicResource AccentBrush}"
                                            TooltipFormat="N0" />
                    </StackPanel>
                </Border>

                <!-- Allocation + Top movers -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Allocation" Style="{StaticResource Caption}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:DonutChart Grid.Column="0" Width="150" Height="150" Thickness="20"
                                                     Segments="{Binding Segments}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Legend}" Margin="20,0,0,0"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                                <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Color}"
                                                        VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PctText}" Style="{StaticResource Caption}" FontSize="12"
                                                           Margin="8,1,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Top movers (24h)" Style="{StaticResource Caption}" />
                            <ItemsControl ItemsSource="{Binding TopMovers}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:CoinIcon Grid.Column="0" Diameter="26" CoinId="{Binding CoinId}"
                                                               ImageUrl="{Binding ImageUrl}" Initial="{Binding Initial}"
                                                               Accent="{Binding Accent}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Symbol}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" FontSize="13.5" />
                                            <TextBlock Grid.Column="2" Text="{Binding ChangeText}" VerticalAlignment="Center" FontSize="13.5"
                                                       Foreground="{Binding IsUp, Converter={StaticResource UpBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasHoldings, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="Nothing to show yet" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
            <TextBlock Text="Add assets in the Holdings tab to see your totals, allocation and history here."
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="420"
                       TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
