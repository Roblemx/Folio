<Window x:Class="Folio.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folio — Locked" Height="360" Width="420"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14">
        <Grid Margin="32,28">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Folio" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="22" FontWeight="Bold" />
                </StackPanel>

                <TextBlock Text="🔒 Your data is encrypted" Style="{StaticResource Heading}" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Text="Enter your password to unlock this portfolio." Style="{StaticResource Caption}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" />

                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" Margin="0,20,0,0"
                             KeyDown="OnPasswordKeyDown" />

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource NegativeBrush}" FontSize="12.5"
                           Margin="2,8,0,0" Visibility="Collapsed" />

                <Button Content="Unlock" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"
                        HorizontalAlignment="Stretch" Click="OnUnlock" />
                <Button Content="Exit" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                        HorizontalAlignment="Stretch" Click="OnExit" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
