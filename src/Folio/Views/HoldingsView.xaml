<UserControl x:Class="Folio.Views.HoldingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Folio.ViewModels"
             xmlns:controls="clr-namespace:Folio.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HoldingsViewModel}">
    <Grid>
        <!-- Main content -->
        <Grid Margin="36,28,36,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right" Content="+  Add asset" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddAssetCommand}"
                        Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}"
                        Margin="0,0,10,0" Command="{Binding RefreshCommand}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Holdings" Style="{StaticResource Hero}" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,3"
                            VerticalAlignment="Center" Margin="14,6,0,0"
                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="offline · last known" Style="{StaticResource Caption}" FontSize="11" />
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="8,3"
                            VerticalAlignment="Center" Margin="14,6,0,0"
                            Visibility="{Binding IsManualMode, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="derived from transactions" Style="{StaticResource Caption}" FontSize="11" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- Column header -->
            <Grid Grid.Row="1" Margin="0,24,8,0"
                  Visibility="{Binding HasHoldings, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Asset" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="1" Text="Amount" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Text="Price" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="24h" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="4" Text="Alloc" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="5" Text="Value" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Rows -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                          Visibility="{Binding HasHoldings, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenAssetCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding CoinId}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="8,12" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <controls:CoinIcon Diameter="34" CoinId="{Binding CoinId}"
                                                                       ImageUrl="{Binding ImageUrl}" Initial="{Binding Initial}"
                                                                       Accent="{Binding Accent}" />
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14" />
                                                        <TextBlock Text="{Binding Symbol}" Style="{StaticResource Caption}" FontSize="11.5" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding AmountText}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontSize="13.5" />
                                                <TextBlock Grid.Column="2" Text="{Binding PriceText}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontSize="13.5" />
                                                <TextBlock Grid.Column="3" Text="{Binding ChangeText}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontSize="13.5"
                                                           Foreground="{Binding IsUp, Converter={StaticResource UpBrush}}" />
                                                <TextBlock Grid.Column="4" Text="{Binding AllocationText}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontSize="13.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="5" Text="{Binding ValueText}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontSize="14" FontWeight="Medium" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasHoldings, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Your portfolio is empty" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                <TextBlock Text="Add an asset to start tracking its value, allocation and P&amp;L."
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="This portfolio is calculated from your transactions. Add entries in the Transactions tab."
                           Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="420"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding IsManualMode, Converter={StaticResource InverseBoolToVis}}" />
                <Button Content="+  Add your first asset" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding AddAssetCommand}"
                        Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="🔒 Everything stays on your machine." Style="{StaticResource Caption}"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

        <!-- Add/Edit editor overlay -->
        <Grid Background="#99000000" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Add asset" Style="{StaticResource Heading}" />

                    <!-- Coin search -->
                    <TextBox Style="{StaticResource TextInput}" Margin="0,16,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search a coin (e.g. bitcoin, eth)…" />
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9" Margin="0,8,0,0"
                            MaxHeight="180"
                            Visibility="{Binding SearchResults.Count, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PickCoinCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Left">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="Transparent" Padding="12,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                            <TextBlock Text="{Binding Symbol}" Style="{StaticResource Caption}"
                                                                       FontSize="11.5" Margin="8,1,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="{Binding SelectedCoinLabel}" FontWeight="Medium" Margin="0,12,0,0"
                               Visibility="{Binding SelectedCoinLabel, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="Amount" Style="{StaticResource Caption}" Margin="0,14,0,6" />
                    <TextBox Style="{StaticResource TextInput}"
                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Average buy price (optional)" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                    <TextBox Style="{StaticResource TextInput}"
                             Text="{Binding AvgPriceText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                Command="{Binding CancelEditorCommand}" />
                        <Button Content="Add" Style="{StaticResource PrimaryButton}" Width="100"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
