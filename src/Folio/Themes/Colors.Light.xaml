<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#F5F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#EDF1F8</Color>
    <Color x:Key="BorderColor">#DCE2EC</Color>
    <Color x:Key="TitleBarColor">#FFFFFF</Color>

    <Color x:Key="TextPrimaryColor">#171C28</Color>
    <Color x:Key="TextSecondaryColor">#5B6677</Color>
    <Color x:Key="TextFaintColor">#9AA2B1</Color>

    <Color x:Key="AccentColor">#2F6FE0</Color>
    <Color x:Key="AccentSoftColor">#E5ECFB</Color>
    <Color x:Key="PositiveColor">#15A85C</Color>
    <Color x:Key="NegativeColor">#E03D4C</Color>
    <Color x:Key="WarningColor">#D9962A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- Categorical palette for allocation segments (same hues, both themes) -->
    <SolidColorBrush x:Key="Cat1Brush" Color="#2F6FE0" />
    <SolidColorBrush x:Key="Cat2Brush" Color="#15A85C" />
    <SolidColorBrush x:Key="Cat3Brush" Color="#E0962A" />
    <SolidColorBrush x:Key="Cat4Brush" Color="#9A57E0" />
    <SolidColorBrush x:Key="Cat5Brush" Color="#E86742" />
    <SolidColorBrush x:Key="Cat6Brush" Color="#13A6B4" />
    <SolidColorBrush x:Key="Cat7Brush" Color="#E03D4C" />
    <SolidColorBrush x:Key="Cat8Brush" Color="#7A8497" />

</ResourceDictionary>
