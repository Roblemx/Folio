<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgColor">#0F1320</Color>
    <Color x:Key="SurfaceColor">#171C2B</Color>
    <Color x:Key="SurfaceAltColor">#1F2638</Color>
    <Color x:Key="BorderColor">#2A3145</Color>
    <Color x:Key="TitleBarColor">#0B0E18</Color>

    <Color x:Key="TextPrimaryColor">#F2F4F8</Color>
    <Color x:Key="TextSecondaryColor">#9AA4B8</Color>
    <Color x:Key="TextFaintColor">#5E6678</Color>

    <Color x:Key="AccentColor">#4F8CFF</Color>
    <Color x:Key="AccentSoftColor">#23304F</Color>
    <Color x:Key="PositiveColor">#2FBF71</Color>
    <Color x:Key="NegativeColor">#F0616D</Color>
    <Color x:Key="WarningColor">#F2B33D</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource PositiveColor}" />
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource NegativeColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <!-- Categorical palette for allocation segments -->
    <SolidColorBrush x:Key="Cat1Brush" Color="#4F8CFF" />
    <SolidColorBrush x:Key="Cat2Brush" Color="#2FBF71" />
    <SolidColorBrush x:Key="Cat3Brush" Color="#F2B33D" />
    <SolidColorBrush x:Key="Cat4Brush" Color="#B06BFF" />
    <SolidColorBrush x:Key="Cat5Brush" Color="#FF7A59" />
    <SolidColorBrush x:Key="Cat6Brush" Color="#19C3D1" />
    <SolidColorBrush x:Key="Cat7Brush" Color="#F0616D" />
    <SolidColorBrush x:Key="Cat8Brush" Color="#8E97A8" />

</ResourceDictionary>
