<UserControl x:Class="Folio.Controls.CoinIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Center">
    <Grid x:Name="Root" Width="32" Height="32">
        <Border x:Name="Fallback" CornerRadius="16" Background="#3A4258">
            <TextBlock x:Name="InitialText" Foreground="White" FontWeight="Bold" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Ellipse x:Name="ImageHost" Visibility="Collapsed">
            <Ellipse.Fill>
                <ImageBrush x:Name="Brush" Stretch="UniformToFill" />
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
